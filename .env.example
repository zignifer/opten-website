# Copy to .env.local and fill in real values. .env.local is gitignored.
#
# Paddle (production: set in Vercel project settings, not here)
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=

# Server-side YouTube Data API access for public Learn comments, also reused by
# local Learn scripts. Set YOUTUBE_API_KEY in Vercel and never expose it as VITE_*.
YOUTUBE_API_KEY=

# Opten Space Learn timestamp tooling — local/script-only.
# Real values should live in .secrets/learn-video.env, not in VITE_* vars.
NOTEBOOKLM_NOTEBOOK_ID=
YOUTUBE_CHANNEL_ID=
